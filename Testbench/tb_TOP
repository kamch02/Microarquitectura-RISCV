module tb_top_riscv_multiciclo;

    logic clk;
    logic reset;

    // Instantiate DUT
    top_riscv_multiciclo DUT (
        .clk   (clk),
        .reset (reset)
    );

    // Clock: 10 ns period
    always #5 clk = ~clk;

    initial begin
        // -------------------------
        // Init
        // -------------------------
        clk   = 0;
        reset = 1;

        // Apply reset
        #20;
        reset = 0;

        // -------------------------
        // Run program
        // -------------------------
        // Enough cycles for program to finish
        #1000;

        // -------------------------
        // Observe memory
        // -------------------------
        $display("----- FINAL MEMORY CHECK -----");

        // Example addresses (adjust if needed)
        // These indices depend on your data_mem implementation
        $display("Memory word [b] = %d", DUT.DMEM.mem[?]);
        $display("Memory byte [a] = %d", DUT.DMEM.mem[?][7:0]);

        $display("Simulation finished.");
        $stop;
    end

endmodule
